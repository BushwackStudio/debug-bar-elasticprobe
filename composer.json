{
  "name": "bushwackstudio/debug-bar-elasticprobe",
  "description": "Extends the Debug Bar plugin for usage with ElasticProbe",
  "type": "wordpress-plugin",
  "keywords": ["wordpress", "plugin", "elasticsearch", "elasticprobe", "search", "debug", "debug bar"],
  "authors": [
    {
      "name": "Nima Shayanfar",
      "email": "nshayanfar@gmail.com"
    },
    {
      "name": "Bushwack Studio",
      "homepage": "https://wpprobe.com/"
    }
  ],
  "require": {
    "php": ">=7.0"
  },
  "license": ["GPL-2.0-only"],
  "require-dev": {
    "10up/phpcs-composer": "^3.0.0",
    "phpcompatibility/phpcompatibility-wp": "*"
  },
  "scripts": {
    "lint": "phpcs debug-bar-elasticprobe.php classes",
    "lint-fix": "phpcbf debug-bar-elasticprobe.php classes",
    "check-php-compat": "phpcs debug-bar-elasticprobe.php classes --standard=PHPCompatibilityWP --extensions=php --runtime-set testVersion 7.0-"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
