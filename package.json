{
  "name": "debug-bar-wpprobe",
  "version": "0.1.0",
  "description": "Extends the Debug Bar plugin for WPProbe queries.",
  "main": "index.js",
  "scripts": {
    "test": "phpunit",
    "start": "composer install && npm install",
    "lint-release": "npm install && composer install && npm run lint",
    "lint-css": "10up-toolkit lint-style",
    "lint-js": "10up-toolkit lint-js",
    "lint-php": "composer run lint",
    "format-js": "10up-toolkit format-js assets/js",
    "format-css": "10up-toolkit lint-style --fix assets/css",
    "lint": "npm run lint-css && npm run lint-js && npm run lint-php",
    "format": "npm run format-js && npm run format-css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BushwackStudio/debug-bar-wpprobe.git"
  },
  "author": "Bushwack Studio",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/BushwackStudio/debug-bar-wpprobe/issues"
  },
  "homepage": "https://github.com/BushwackStudio/debug-bar-wpprobe#readme",
  "eslintConfig": {
    "extends": "@10up/eslint-config/wordpress"
  },
  "devDependencies": {
    "10up-toolkit": "^6.3.0"
  }
}
